[Unit]
Description=SmartPlug Controller
After=network.target

[Service]
Type=simple
User=mhy
Group=mhy
WorkingDirectory=/home/mhy/plugs
Environment=PLUGS_DB=/home/mhy/plugs/plugs.db
ExecStart=/home/mhy/bin/plugs_controller

Nice=0
TimeoutStopSec=0
Restart=always
RuntimeDirectory=paninv
RuntimeDirectoryMode=2755
PIDFile=/run/paninv/plugs_controller.pid

UMask=0022
ReadOnlyPaths=/
ReadWritePaths=/home/mhy/plugs
PrivateTmp=yes
#PrivateDevices=yes
#ProtectHome=yes

[Install]
WantedBy=multi-user.target
Alias=plugs.service
