<!DOCTYPE html>
<html>
    <head>
        <title>{{.PageTitle}}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <style>
            * {
                font-family: arial;
            }
            table, th, td {
                border: 1px solid black;
                border-collapse: collapse;
            }
            th, td {
              padding: 10px;
            }
            thead {
                color: white;
                background-color: darkgreen;
            }
            .thresholds {
                margin-top: 5px;
                font-size: smaller;
                white-space: nowrap;
            }
            .thresholds input {
                width: 5em;
            }
            .info {
                margin-top: 5px;
                font-style: normal;
                font-size: smaller;
            }
        </style>
    </head>
    <body>
        <h1>{{ .PageTitle }}</h1>
        <h2>Sensors</h2>
        <table>
            <thead>
                <tr>
                    <th>Sensor</th>
                    <th>Plug</th>
                    <th>Value</th>
                    <th>State</th>
                    <th>Updated</th>
                </tr>
            </thead>
            <tbody>
                {{ range .Sensors -}}
                <tr>
                    <td>
                        <a href="http://{{ .IpAddress }}" target="_blank">
                            <div>{{ .SensorId }}</div>
                            <div class="info">({{ .IpAddress }})</div>
                        </a>
                    </td>
                    <td>
                        {{ .PlugId }}
                        <form class="thresholds" method="post" action="/sensor/{{ .SensorId }}/plug/{{ .PlugId }}/thresholds">
                            <input type="number" step="any" name="min" value="{{ .MinInput }}" required aria-label="min">
                            &lt;
                            <input type="number" step="any" name="max" value="{{ .MaxInput }}" required aria-label="max">
                            <button type="submit">Set</button>
                        </form>
                    </td>
                    <td>{{ .Value | NoBreak }}</td>
                    <td>{{ .State }}</td>
                    <td><span>{{ .UpdatedAt | NoBreak }}</span></td>
                </tr>
                {{ end -}}
            </tbody>
        </table>
        <h2>Plugs</h2>
        <table>
            <thead>
                <tr>
                    <th>Plug</th>
                    <th>State</th>
                    <th>Response</th>
                    <th>Updated</th>
                </tr>
            </thead>
            <tbody>
                {{ range .Plugs -}}
                <tr>
                    <td>
                        <a href="http://{{ .IpAddress }}" target="_blank">
                            <div>{{ .PlugId }}</div>
                            <div class="info">({{ .IpAddress }})</div>
                        </a>
                    </td>
                    <td>{{ .State }}</td>
                    <td>{{ .Response }}</td>
                    <td><span>{{ .UpdatedAt | NoBreak }}</span></td>
                </tr>
                {{ end -}}
            </tbody>
        </table>
        <script>
            // Refresh every 30 seconds, unless a threshold is being edited.
            let editing = false;
            document.querySelectorAll(".thresholds input").forEach(input => {
                input.addEventListener("input", () => { editing = true; });
            });
            setInterval(() => {
                if (!editing && !document.activeElement.matches(".thresholds input")) {
                    location.reload();
                }
            }, 30000);
        </script>
   </body>
</html>
