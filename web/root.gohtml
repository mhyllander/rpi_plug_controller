<!DOCTYPE html>
<html>
    <head>
        <title>{{.PageTitle}}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <style>
            * {
                font-family: arial;
            }
            table, th, td {
                border: 1px solid black;
                border-collapse: collapse;
            }
            th, td {
              padding: 10px;
            }
            thead {
                color: white;
                background-color: darkgreen;
            }
            .info {
                margin-top: 5px;
                font-style: normal;
                font-size: smaller;
            }
        </style>
        <script type='text/javascript'>
            function getConfig() {
            }
            function sendConfig() {
            }
        </script>
    </head>
    <body>
        <h1>{{ .PageTitle }}</h1>
        <h2>Sensors</h2>
        <table>
            <thead>
                <tr>
                    <th>Sensor</th>
                    <th>Value</th>
                    <th>Plug</th>
                    <th>State</th>
                    <th>Updated</th>
                </tr>
            </thead>
            <tbody>
                {{ range .Sensors -}}
                <tr>
                    <td>
                        <a href="http://{{ .IpAddress }}" target="_blank">
                            <div>{{ .SensorId }}</div>
                            <div class="info">({{ .IpAddress }})</div>
                        </a>
                    </td>
                    <td>{{ .Value | NoBreakF }}</td>
                    <td>{{ .PlugId }}<br><div class=info>{{ .Min | NoBreakF }}&lt;{{ .Max | NoBreakF }}</div></td>
                    <td>{{ .State }}</td>
                    <td><span>{{ .UpdatedAt | NoBreak }}</span></td>
                </tr>
                {{ end -}}
            </tbody>
        </table>
        <h2>Plugs</h2>
        <table>
            <thead>
                <tr>
                    <th>Plug</th>
                    <th>State</th>
                    <th>Updated</th>
                    <th>Response</th>
                </tr>
            </thead>
            <tbody>
                {{ range .Plugs -}}
                <tr>
                    <td>
                        <a href="http://{{ .IpAddress }}" target="_blank">
                            <div>{{ .PlugId }}</div>
                            <div class="info">({{ .IpAddress }})</div>
                        </a>
                    </td>
                    <td>{{ .State }}</td>
                    <td><span>{{ .UpdatedAt | NoBreak }}</span></td>
                    <td>{{ .Response }}</td>
                </tr>
                {{ end -}}
            </tbody>
        </table>
   </body>
</html>
